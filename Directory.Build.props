<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)artifacts/nuget-packages</RestorePackagesPath>
    <HostSourceRoot Condition="'$(HostSourceRoot)' == ''">$(MSBuildThisFileDirectory).host/project-workbench</HostSourceRoot>
  </PropertyGroup>
</Project>
